# Send the bare domain to www, which is what the canonical URL and og:url
# in index.html already point at. Plesk/nginx handles HTTP -> HTTPS ahead
# of Apache, so this only ever sees HTTPS requests and cannot ping-pong
# with that redirect. Matching the exact non-www host (rather than "not
# www") keeps it inert for any other hostname routed to this docroot.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^madeineire\.com$ [NC]
RewriteRule ^(.*)$ https://www.madeineire.com/$1 [R=301,L]

# HSTS. Deliberately no includeSubDomains: the cert covers only
# madeineire.com and www.madeineire.com, while wildcard DNS resolves every
# subdomain and webmail.madeineire.com has no valid cert. Including
# subdomains would force HTTPS there and make it unreachable, pinned in
# visitors' browsers for the full max-age. No preload either, for the same
# reason -- it requires includeSubDomains and is effectively irreversible.
# Starting at 300s to confirm the header lands; raise once verified.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=300"
</IfModule>
